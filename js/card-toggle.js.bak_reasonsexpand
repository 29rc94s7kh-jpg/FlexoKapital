(function(){
  var grids = Array.prototype.slice.call(document.querySelectorAll('.services-grid, .pillars-grid'));
  grids.forEach(function(grid){
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.card.expandable'));
    if (!cards.length) return;
    function columnCount(){
      var cols = getComputedStyle(grid).gridTemplateColumns.split(' ').filter(Boolean);
      return cols.length || 1;
    }
    function rowPartnerIndexes(i, cols){
      if (cols <= 1) return [];
      var rowStart = Math.floor(i / cols) * cols;
      var rowEnd = Math.min(rowStart + cols, cards.length);
      var partners = [];
      for (var j = rowStart; j < rowEnd; j++){
        if (j !== i) partners.push(j);
      }
      return partners;
    }
    function refresh(){
      var cols = columnCount();
      cards.forEach(function(card, i){
        if (card.classList.contains('is-open')) {
          card.classList.remove('row-partner-open');
          return;
        }
        var partners = rowPartnerIndexes(i, cols);
        var anyPartnerOpen = partners.some(function(j){
          return cards[j].classList.contains('is-open');
        });
        card.classList.toggle('row-partner-open', anyPartnerOpen);
      });
    }
    cards.forEach(function(card){
      function toggleCard(){
        var open = card.classList.toggle('is-open');
        card.setAttribute('aria-expanded', open ? 'true' : 'false');
        refresh();
      }
      card.addEventListener('click', toggleCard);
      card.addEventListener('keydown', function(e){
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleCard();
        }
      });
    });
    refresh();
  });
})();
